{
  "schemaVersion": 1,
  "slug": "my-demo",
  "title": "Nueva demo",
  "mode": "dry-run",
  "_provisional": "Copia esta carpeta a demos/<slug>/, cambia slug, campos y evento. Mantén mode=dry-run hasta tener el appKey del proyecto de demo.",
  "indigitall": {
    "sdkVersion": "4.18.1",
    "appKey": "REPLACE_WITH_DEMO_APP_KEY",
    "urlDeviceApi": null,
    "pushMode": "enabled",
    "logLevel": "ERROR"
  },
  "identity": {
    "strategy": "email",
    "prefix": ""
  },
  "fields": [
    {
      "id": "name",
      "label": "Nombre",
      "type": "text",
      "required": true
    },
    {
      "id": "email",
      "label": "Correo electrónico",
      "type": "email",
      "required": true
    },
    {
      "id": "phone",
      "label": "Teléfono",
      "type": "tel",
      "required": true,
      "countries": [
        "CO",
        "MX",
        "PE",
        "CL",
        "US",
        "EC",
        "HN",
        "ES"
      ],
      "defaultCountry": "CO",
      "help": "Te llamaremos o escribiremos por WhatsApp a este número."
    },
    {
      "id": "product",
      "label": "Producto de interés",
      "type": "select",
      "required": true,
      "options": [
        "Plan Hogar",
        "Plan Móvil",
        "Plan Empresas"
      ]
    },
    {
      "id": "consent",
      "label": "Acepto que me contacten por teléfono y WhatsApp sobre mi solicitud.",
      "type": "checkbox",
      "required": true
    }
  ],
  "cdpMapping": [
    {
      "cdpField": "name",
      "from": "name",
      "type": "string"
    },
    {
      "cdpField": "email",
      "from": "email",
      "type": "string"
    },
    {
      "cdpField": "Phone",
      "from": "phone.digits",
      "type": "number"
    },
    {
      "cdpField": "Country_code",
      "from": "phone.countryCode",
      "type": "number"
    },
    {
      "cdpField": "producto_de_interes",
      "from": "product",
      "type": "string"
    }
  ],
  "staticAttributes": {
    "Origen": "demo_my_demo"
  },
  "event": {
    "name": "lead_submitted",
    "data": [
      {
        "key": "name",
        "from": "name"
      },
      {
        "key": "phone",
        "from": "phone.e164"
      },
      {
        "key": "product",
        "from": "product"
      }
    ],
    "includeStaticAttributes": true,
    "includeTimestamp": false
  },
  "flow": {
    "verifyProfile": "off",
    "operationTimeoutMs": 10000
  },
  "guard": {
    "cooldownSeconds": 120
  },
  "diagnostics": {
    "queryParam": "debug"
  },
  "submitLabel": "Llámame",
  "busyLabel": "Enviando…",
  "successMessage": "¡Gracias! Recibimos tu solicitud. En breve te contactaremos."
}
